{
  "mcpServers": {
    "Memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "Sequential Thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "Cloudflare": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "Next.js Devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp"
      ]
    },
    "21st.dev": {
      "type": "http",
      "url": "https://21st.dev/api/mcp"
    }
  }
}
